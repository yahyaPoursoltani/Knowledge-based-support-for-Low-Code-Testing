# Local development settings. Copy to .env (git-ignored) for Docker Compose.
# The application and tests read these as environment variables; export the same
# values in your shell or PyCharm run configuration.
# Set the password BEFORE the first `docker compose up`. Changing it after the
# Neo4j volume exists requires recreating the volume: docker compose down -v
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-dev
